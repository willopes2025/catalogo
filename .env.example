# Copie para .env e ajuste
DATABASE_URL=postgres://aritana:aritana@localhost:5432/aritana
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-segredo-longo
PORT=3000
DOMINIO=localhost
DB_PASSWORD=aritana

# E-mail (códigos de assinatura). Sem isso, em produção a assinatura não envia código.
SMTP_URL=
EMAIL_REMETENTE="Aritana Semijoias <naoresponda@aritanaonline.com.br>"
# Avisos automáticos por e-mail (0 desliga o agendador; a hora e os destinatários ficam na tela)
AVISOS_AUTOMATICOS=1
PAINEL_URL=https://aritana.wideic.com

# Assertiva (consulta de CPF). Conferir endereços com a documentação recebida da Assertiva.
ASSERTIVA_CLIENT_ID=
ASSERTIVA_CLIENT_SECRET=
# ASSERTIVA_URL=https://api.assertivasolucoes.com.br
# ASSERTIVA_TOKEN_PATH=/oauth2/v3/token
# ASSERTIVA_CPF_PATH=/localize/v3/cpf?cpf={cpf}&idFinalidade={finalidade}
# ASSERTIVA_FINALIDADE=1

# Asaas (boletos e Pix). Teste: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_URL=https://api-sandbox.asaas.com/v3
# Token que o Asaas envia no aviso de pagamento (cadastrar o webhook em https://<domínio>/api/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=

# Emissor fiscal Focus NFe. Teste: https://homologacao.focusnfe.com.br · Produção: https://api.focusnfe.com.br
FOCUS_NFE_TOKEN=
FOCUS_NFE_URL=https://homologacao.focusnfe.com.br

# Chamados de suporte também chegam por e-mail neste endereço
EMAIL_SUPORTE=
